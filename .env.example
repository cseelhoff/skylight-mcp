# Skylight MCP — auth. Supply EITHER a refresh token you already hold, OR an
# email + password pair, which mints one via the OAuth2 authorization-code flow.
SKYLIGHT_EMAIL=you@example.com
SKYLIGHT_PASSWORD=your-password

# Alternative to the pair above: a token you already hold. Scoped and revocable,
# and it never touches the rate-limited login endpoint on a cold start.
# SKYLIGHT_REFRESH_TOKEN=your-refresh-token

# Optional: pick a frame when your account has more than one (see skylight_list_frames).
# SKYLIGHT_FRAME_ID=3435252

# Optional friendly name shown in diagnostics. Defaults to the email.
# SKYLIGHT_NAME=The Halls

# Optional: the token is cached between runs so a restart does not
# re-authenticate. Set to false to turn that off.
# SKYLIGHT_TOKEN_CACHE=false
# Optional: where that cache lives. Defaults to $MCP_DATA_DIR/.skylight-mcp/tokens.json.
# SKYLIGHT_TOKEN_FILE=/path/to/cache.json

# Optional: only used with `--http`. Shared secret every HTTP request must carry,
# as `Authorization: Bearer <secret>` or in the URL `/mcp/<secret>`.
# At least 32 URL-safe characters: openssl rand -hex 32
# MCP_HTTP_SECRET=
# MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=127.0.0.1
